.venv/
__pycache__/
*.pyc

data/
xp_logs/
out/
*.log
*.ipynb
*.parquet
*.npy
dist/
build/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
*~
*.ipynb_checkpoints/
.env

# The in-repo test fixture holds tracked parquet / npz files: re-include them after the extension globs above.
!tests/fixtures/
!tests/fixtures/**

# Productions/ holds generation runs (large, never committed). Track only the vocabulary the code imports.
# Negate each dir AND its contents (the /** form): git cannot re-include a file whose parent dir stayed excluded.
Productions/*
!Productions/Intersection_vocab/
!Productions/Intersection_vocab/**

# The TOP-LEVEL data/ dir holds tracked metadata (manifests, licence, README). Re-include it explicitly
# (anchored to the root): the bare `data/` rule above still ignores nested */data/ directories elsewhere.
!/data/
!/data/**
# ... but never the downloaded archives' content nor fetch_data.py's unpack directory (the release data archive unpacks into Productions/, ignored above).
/data/results/
/data/.fetch_*/
